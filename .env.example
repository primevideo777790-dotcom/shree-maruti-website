# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Payment Backend Configuration
# Default Merchant UPI VPA used for instant UPI QR code & App Intent links
MERCHANT_UPI_VPA="shreemarutikrupa@okaxis"
MERCHANT_NAME="Shree Maruti Krupa"

# PhonePe Payment Gateway Configuration
# Sandbox test credentials are pre-configured. Replace with your live credentials for production.
PHONEPE_MERCHANT_ID="PGTESTPAYUAT"
PHONEPE_SALT_KEY="" # Provided by PhonePe Merchant Dashboard
PHONEPE_SALT_INDEX="1"
PHONEPE_ENV="sandbox" # Options: "sandbox" (Testing) or "production" (Live)
PHONEPE_UPI_VPA="shreemarutikrupa@ybl" # PhonePe Business UPI ID

# Optional: Razorpay payment gateway credentials for card/netbanking payments
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""


# Shiprocket API (server-side only; NEVER put these in VITE_* variables)
# Use the separate API user created in Shiprocket Settings -> API Users.
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
# Optional: if blank, the server automatically uses the first active pickup address in Shiprocket.
SHIPROCKET_PICKUP_LOCATION=""
# Package defaults used when creating an order. Adjust to your actual packed parcel.
SHIPROCKET_WEIGHT_KG="0.50"
SHIPROCKET_LENGTH_CM="20"
SHIPROCKET_BREADTH_CM="15"
SHIPROCKET_HEIGHT_CM="10"
